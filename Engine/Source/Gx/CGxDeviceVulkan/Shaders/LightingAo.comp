// LIGHTING: SSAO at half resolution (Lighting.hlsl AoPs): x the unoccluded fraction, y the pixel's clip w (0 = sky)
#version 450
#extension GL_GOOGLE_include_directive : require
#include "Lighting.glsl"

layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D gxOut;

vec4 Ao(vec2 pos) {
    vec2 pixel = gxViewportPx.xy + floor(pos) * 2.0 + 0.5;
    float d = GxDepthAt(GxClampPixel(pixel));

    if (!GxIsGeometry(d)) {
        return vec4(1.0, 0.0, 0.0, 0.0);
    }

    vec3 p = GxViewPos(pixel, d);
    float w = GxClipW(p);
    float fade = 1.0 - clamp((w - gxAo.z) / max(gxAo.w - gxAo.z, 1.0), 0.0, 1.0);

    if (fade <= 0.0) {
        return vec4(1.0, w, 0.0, 0.0);
    }

    vec3 l = GxViewPos(pixel - vec2(1.0, 0.0), GxDepthAt(GxClampPixel(pixel - vec2(1.0, 0.0))));
    vec3 r = GxViewPos(pixel + vec2(1.0, 0.0), GxDepthAt(GxClampPixel(pixel + vec2(1.0, 0.0))));
    vec3 u = GxViewPos(pixel - vec2(0.0, 1.0), GxDepthAt(GxClampPixel(pixel - vec2(0.0, 1.0))));
    vec3 b = GxViewPos(pixel + vec2(0.0, 1.0), GxDepthAt(GxClampPixel(pixel + vec2(0.0, 1.0))));
    vec3 dx = dot(r - p, r - p) < dot(p - l, p - l) ? r - p : p - l;
    vec3 dy = dot(b - p, b - p) < dot(p - u, p - u) ? b - p : p - u;
    vec3 n = normalize(cross(dy, dx));
    n = dot(n, p) > 0.0 ? -n : n;

    float radius = gxAo.x;
    float radiusPx = clamp(radius * gxAoProj.x / max(w, 0.01), 3.0, gxViewportPx.w * 0.15);
    float noise = fract(52.9829189 * fract(dot(pos, vec2(0.06711056, 0.00583715))));
    float bias = 2.0 * gxAoProj.y * w * w;
    float sum = 0.0;
    const uint count = 12u;

    for (uint s = 0u; s < count; s++) {
        float t = (float(s) + 0.5) / float(count);
        float angle = (t * 7.0 + noise) * 6.2831853;
        vec2 q = pixel + vec2(cos(angle), sin(angle)) * (radiusPx * t);
        ivec2 qi = GxClampPixel(q);
        vec3 v = GxViewPos(vec2(qi) + 0.5, GxDepthAt(qi)) - p;
        float vv = dot(v, v);
        float range = clamp(1.0 - vv / (radius * radius * 4.0), 0.0, 1.0);
        sum += clamp((dot(v, n) - bias) * inversesqrt(max(vv, 0.0001)) - 0.05, 0.0, 1.0) * range;
    }

    float ao = clamp(1.0 - gxAo.y * sum / float(count), 0.0, 1.0);
    return vec4(mix(1.0, ao, fade), w, 0.0, 0.0);
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(id, ivec2(gxTarget.xy)))) {
        return;
    }

    imageStore(gxOut, id, Ao(vec2(id) + 0.5));
}
