// LIGHTING: exposure, bloom and the tonemap (Lighting.hlsl TonemapPs) over the world viewport of the 8-bit scene
// (gxColor; Vulkan has no float scene), gxColor2 bloom level 0. Written B, G, R, A, as LightingApply.comp.
#version 450
#extension GL_GOOGLE_include_directive : require
#include "Lighting.glsl"

layout(set = 0, binding = 3, rgba8) uniform writeonly image2D gxOut;

vec3 GxNeutral(vec3 c) {
    const float shoulder = 0.8;
    float m = max(c.r, max(c.g, c.b));

    if (m <= shoulder) {
        return c;
    }

    float mapped = shoulder + (1.0 - shoulder) * (1.0 - exp(-(m - shoulder) / (1.0 - shoulder)));
    return c * (mapped / m);
}

vec3 GxAces(vec3 c) {
    return clamp(c * (2.51 * c + 0.03) / (c * (2.43 * c + 0.59) + 0.14), 0.0, 1.0);
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(id, ivec2(gxViewportPx.zw)))) {
        return;
    }

    ivec2 px = id + ivec2(gxViewportPx.xy);
    vec4 s = texelFetch(gxColor, px, 0);
    vec3 c = GxDec(s.rgb) * gxTone.x;

    if (gxBloom.w > 0.0) {
        c += textureLod(gxColor2, (vec2(px) + 0.5) * gxSource.xy, 0.0).rgb * (gxBloom.z / gxSource.z);
    }

    // no NaN or negative light reaches the frame
    bvec3 nan = greaterThan(floatBitsToUint(c) & 0x7FFFFFFFu, uvec3(0x7F800000u));
    c = max(mix(c, vec3(0.0), nan), 0.0);

    if (gxTone.y > 1.5) {
        c = GxAces(c);
    } else if (gxTone.y > 0.5) {
        c = GxNeutral(c);
    } else {
        c = clamp(c, 0.0, 1.0);
    }

    imageStore(gxOut, px, vec4(GxEnc(c), s.a).bgra);
}
