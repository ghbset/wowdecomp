// LIGHTING: the bloom chain (Lighting.hlsl BloomPrefilterPs, BloomDownPs, BloomUpPs) by gxPass.x: 0 the prefilter
// (gxColor the scene: decoded, exposed, the soft knee; nothing outside the world viewport, which the D3D11 device
// clears black), 1 a 13-tap down, 2 a 3x3 tent added into the output (read back from it: no blend in compute).
#version 450
#extension GL_GOOGLE_include_directive : require
#include "Lighting.glsl"

layout(set = 0, binding = 3, rgba16f) uniform image2D gxOut;

const vec2 kOffsets[13] = vec2[13](vec2(-2, -2), vec2(0, -2), vec2(2, -2), vec2(-1, -1), vec2(1, -1), vec2(-2, 0), vec2(0, 0), vec2(2, 0), vec2(-1, 1), vec2(1, 1), vec2(-2, 2), vec2(0, 2), vec2(2, 2));
const float kWeights[13] = float[13](0.03125, 0.0625, 0.03125, 0.125, 0.125, 0.0625, 0.125, 0.0625, 0.125, 0.125, 0.03125, 0.0625, 0.03125);

vec3 Down13(vec2 uv, vec2 t, bool decode) {
    vec3 sum = vec3(0.0);

    for (int k = 0; k < 13; k++) {
        vec2 at = uv + kOffsets[k] * t;
        vec3 c = textureLod(gxColor, at, 0.0).rgb;

        if (decode) {
            vec2 px = at / t;
            bool inside = all(greaterThanEqual(px, gxViewportPx.xy)) && all(lessThan(px, gxViewportPx.xy + gxViewportPx.zw));
            c = inside ? min(GxDec(c) * gxTone.x, vec3(16.0)) : vec3(0.0);
        }

        sum += c * kWeights[k];
    }

    return sum;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(id, ivec2(gxTarget.xy)))) {
        return;
    }

    vec2 uv = (vec2(id) + 0.5) * gxTarget.zw;
    vec2 t = gxSource.xy;
    vec3 c;

    if (gxPass.x < 0.5) {
        c = Down13(uv, t, true);
        float bright = max(c.r, max(c.g, c.b));
        float knee = gxBloom.y;
        float soft = clamp(bright - gxBloom.x + knee, 0.0, 2.0 * knee);
        soft = soft * soft / (4.0 * knee + 0.00001);
        c *= max(soft, bright - gxBloom.x) / max(bright, 0.00001);
    } else if (gxPass.x < 1.5) {
        c = Down13(uv, t, false);
    } else {
        vec3 sum = textureLod(gxColor, uv, 0.0).rgb * 4.0;
        sum += (textureLod(gxColor, uv + vec2(-t.x, 0.0), 0.0).rgb + textureLod(gxColor, uv + vec2(t.x, 0.0), 0.0).rgb + textureLod(gxColor, uv + vec2(0.0, -t.y), 0.0).rgb + textureLod(gxColor, uv + vec2(0.0, t.y), 0.0).rgb) * 2.0;
        sum += textureLod(gxColor, uv - t, 0.0).rgb + textureLod(gxColor, uv + t, 0.0).rgb + textureLod(gxColor, uv + vec2(t.x, -t.y), 0.0).rgb + textureLod(gxColor, uv + vec2(-t.x, t.y), 0.0).rgb;
        c = imageLoad(gxOut, id).rgb + sum / 16.0;
    }

    imageStore(gxOut, id, vec4(c, 1.0));
}
